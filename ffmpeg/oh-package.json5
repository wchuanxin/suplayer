{
  "name": "@suplayer/ffmpeg",
  "version": "1.17.0",
  "description": "FFmpeg-powered media kernel for HarmonyOS: probing with PSI program table, frame extraction, audio/video/subtitle decoding with NV12 direct-write software rendering (multi-core via swThreads) and H.264/HEVC hardware decoding (open-time and mid-stream fallback), AVS2/AVS3 support, multi-program TS, DVB subtitles, runtime seek, playback speed, frame capture, JS custom I/O (streamio), fd:// sources, transcoding (OpenH264 + AAC), and live streaming (HTTPS, HLS, RTSP) via bundled OpenSSL.",
  "main": "Index.ets",
  "author": {
    "name": "suplayer",
    "email": "wchuanxin@qq.com",
    "url": "https://gitee.com/wchuanxin/suplayer"
  },
  "license": "GPL-3.0-or-later",
  "keywords": [
    "ffmpeg",
    "decode",
    "transcode",
    "subtitles",
    "hls",
    "live-streaming",
    "mpegts",
    "avs2",
    "avs3",
    "harmonyos"
  ],
  "homepage": "https://gitee.com/wchuanxin/suplayer",
  "repository": "https://gitee.com/wchuanxin/suplayer",
  "bugs": "https://gitee.com/wchuanxin/suplayer/issues",
  "dependencies": {
    "libffmpeg.so": "file:./src/main/cpp/types/libffmpeg"
  }
}
