{
  "name": "@suplayer/ffmpeg",
  "version": "1.7.0",
  "description": "FFmpeg-powered media kernel for HarmonyOS: media probing with MPEG-TS PSI program table, frame extraction, audio/video decoding with Surface rendering, H.264/HEVC hardware decoding with auto fallback, AVS2/AVS3 software decoding, multi-track TS switching, multi-program TS playback, DVB subtitles, transcoding (OpenH264 + AAC), and live streaming (HTTPS, HLS) via bundled OpenSSL.",
  "main": "Index.ets",
  "author": {
    "name": "suplayer",
    "email": "wchuanxin@qq.com",
    "url": "https://gitee.com/wchuanxin/suplayer"
  },
  "license": "GPL-3.0-or-later",
  "keywords": [
    "ffmpeg",
    "decode",
    "transcode",
    "subtitles",
    "hls",
    "live-streaming",
    "mpegts",
    "avs2",
    "avs3",
    "harmonyos"
  ],
  "homepage": "https://gitee.com/wchuanxin/suplayer",
  "repository": "https://gitee.com/wchuanxin/suplayer",
  "bugs": "https://gitee.com/wchuanxin/suplayer/issues",
  "dependencies": {
    "libffmpeg.so": "file:./src/main/cpp/types/libffmpeg"
  }
}
