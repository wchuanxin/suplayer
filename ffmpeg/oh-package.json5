{
  "name": "@suplayer/ffmpeg",
  "version": "1.7.0",
  "description": "FFmpeg-powered media kernel for HarmonyOS: media probing with MPEG-TS PSI program table (PAT/PMT), frame extraction, audio/video software decoding with Surface rendering, hardware video decoding via OH_AVCodec (H.264/H.265, surface mode, auto fallback), AVS2 (GB/T 33475.2, via davs2) and AVS3 (IEEE.1857.10, via uavs3d) software decoding, multi-track TS track switching, multi-program TS (MPTS) playback with program locking, DVB subtitle decoding (PMT-declared streams, composited RGBA), transcode/mux pipeline (libopenh264 + AAC), and network/live streaming (HTTPS, HLS) via bundled OpenSSL.",
  "main": "Index.ets",
  "author": {
    "name": "suplayer",
    "email": "wchuanxin@qq.com",
    "url": "https://gitee.com/wchuanxin/suplayer"
  },
  "license": "GPL-3.0-or-later",
  "keywords": [
    "ffmpeg",
    "media",
    "probe",
    "decode",
    "transcode",
    "subtitles",
    "hls",
    "live-streaming",
    "mpegts",
    "avs2",
    "avs3",
    "harmonyos"
  ],
  "homepage": "https://gitee.com/wchuanxin/suplayer",
  "repository": "https://gitee.com/wchuanxin/suplayer",
  "bugs": "https://gitee.com/wchuanxin/suplayer/issues",
  "dependencies": {
    "libffmpeg.so": "file:./src/main/cpp/types/libffmpeg"
  }
}
